{
    "search": {
        "button": false,
    },
    "global_lsp_settings": {
        "button": false,
    },
    "status_bar": {
        "active_language_button": false,
        "cursor_position_button": false,
    },
    "diff_view_style": "unified",
    "project_panel": {
        "dock": "left",
    },
    "outline_panel": {
        "button": false,
        "dock": "left",
    },
    "git_panel": {
        "dock": "left",
    },
    "edit_predictions": {
        "provider": "zed",
        "mode": "subtle",
    },
    "diagnostics": {
        "button": false,
        "inline": {
            "update_debounce_ms": 100,
        },
    },
    "agent": {
        "notify_when_agent_waiting": "never",
        "favorite_models": [
            {
                "provider": "openai",
                "model": "gpt-5.6-sol",
                "enable_thinking": true,
                "effort": "low",
            },
            {
                "provider": "opencode",
                "model": "free/big-pickle",
                "enable_thinking": false,
            },
        ],
        "button": false,
        "sidebar_side": "right",
        "dock": "right",
        "default_model": {
            "enable_thinking": false,
            "provider": "opencode",
            "model": "free/big-pickle",
        },
        "default_profile": "ask",
        "model_parameters": [],
    },
    "collaboration_panel": {
        "button": false,
        "dock": "right",
    },
    "terminal": {
        "dock": "bottom",
        "font_family": "Geist Mono",
        "blinking": "on",
    },
    "lsp": {
        "vtsls": {
            "settings": {
                "typescript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always",
                    },
                },
                "javascript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always",
                    },
                },
            },
            "enable_lsp_tasks": true,
        },
        "eslint": {
            "settings": {
                "codeActionOnSave": {
                    "rules": ["import/order"],
                },
            },
        },
        "tailwindcss-language-server": {
            "settings": {
                "classFunctions": ["cva", "cx"],
                "experimental": {
                    "classRegex": ["[cls|className]\\s\\:\\=\\s\"([^\"]*)"],
                },
            },
        },
    },
    "languages": {
        "JavaScript": {
            "formatter": {
                "external": {
                    "command": "prettier",
                    "arguments": ["--stdin-filepath", "{buffer_path}"],
                },
            },
        },
    },
    "enable_language_server": true,
    "base_keymap": "VSCode",
    "theme": "Dark Midnight",
    "vim_mode": true,
    "relative_line_numbers": "enabled",
    "cursor_blink": true,
    "ui_font_size": 14,
    "buffer_font_size": 14,
    "buffer_font_family": "Geist Mono",
    "soft_wrap": "none",
    "preferred_line_length": 80,
    "wrap_guides": [80],
    "show_wrap_guides": true,
    "tab_size": 4,
    "remove_trailing_whitespace_on_save": true,
    "show_call_status_icon": true,
    "show_whitespaces": "selection",
    "format_on_save": "on",
    "formatter": "prettier",
    "show_completions_on_input": true,
    "show_edit_predictions": true,
}
